# ─── Required for live answers ───────────────────────────────
# Anthropic API key (console.anthropic.com → API Keys). Server-side only.
ANTHROPIC_API_KEY=

# ─── Recommended ─────────────────────────────────────────────
# Voyage AI key for vector embeddings (dashboard.voyageai.com). Without it,
# retrieval falls back to Postgres full-text search only.
VOYAGE_API_KEY=

# ─── Database ────────────────────────────────────────────────
# Postgres connection string (Neon via the Vercel Marketplace). Use the
# *pooled* URL. If unset, a local PGlite database is created in ./.data
# (local development only; it does not work on Vercel).
DATABASE_URL=

# ─── File storage ────────────────────────────────────────────
# Set automatically when you connect a Vercel Blob store. If unset, files
# are written to ./.data/uploads (local development only).
BLOB_READ_WRITE_TOKEN=

# ─── Access control (demo) ───────────────────────────────────
# Passcode everyone types to open the app. Leave blank to disable the gate
# (local development only).
DEMO_PASSCODE=
# Separate passcode for the Admin Panel.
ADMIN_PASSCODE=
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ─── Optional overrides ──────────────────────────────────────
# ANSWER_MODEL=claude-sonnet-5-5
# FAST_MODEL=claude-haiku-5-5
# VOYAGE_MODEL=voyage-4
